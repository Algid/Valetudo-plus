# Currently (2022-05-22) we need to ignore peer dependencies as those break the frontend when using react v18
legacy-peer-deps=true
# local build env: npm>=12 blocks git deps by default; allow the two Hypfer forks this repo pins
allow-git=https://github.com/Hypfer/upx.git
allow-git=https://github.com/Hypfer/swagger-jsdoc.git
